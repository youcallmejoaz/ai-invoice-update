# Gemini (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Twilio (Console -> Account Info) and the WhatsApp Sandbox sender
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Google Sheets (service account JSON key + the spreadsheet ID from its URL)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=

# Public URL of this app, e.g. your ngrok URL (no trailing slash).
# Used to validate Twilio's request signature. Leave empty to skip validation (local testing only).
PUBLIC_BASE_URL=
