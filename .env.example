# Gemini (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# WhatsApp Cloud API (Meta developer dashboard, see README)
WHATSAPP_ACCESS_TOKEN=
# Any string you invent; you type the same string into the webhook settings in Meta's dashboard
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret. Used to check that webhook calls really come from Meta.
META_APP_SECRET=
GRAPH_API_VERSION=v26.0

# Google Sheets (service account JSON key + the spreadsheet ID from its URL)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=
